<?xml version="1.0" encoding="utf-8"?>

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Single translucent dark-blue glass surface -->
    <gradient
        android:angle="90"
        android:startColor="#501B3047"
        android:centerColor="#4518273A"
        android:endColor="#50132131" />

    <corners
        android:radius="28dp" />

    <!-- Very thin glass border -->
    <stroke
        android:width="1dp"
        android:color="#55D9E8F5" />

</shape>