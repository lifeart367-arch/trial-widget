<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep translucent glass -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#42FFFFFF" />

            <corners android:radius="30dp" />

            <stroke
                android:width="1dp"
                android:color="#A0FFFFFF" />

        </shape>
    </item>

    <!-- Subtle dark glass depth -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#28FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#18000000" />

            <corners android:radius="29dp" />

        </shape>

    </item>

    <!-- Large soft glass reflection -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="65dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#45FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />

            <corners android:radius="27dp" />

        </shape>

    </item>

    <!-- Thin inner highlight -->
    <item
        android:left="6dp"
        android:top="5dp"
        android:right="6dp"
        android:bottom="8dp">

        <shape android:shape="rectangle">

            <solid android:color="#08FFFFFF" />

            <corners android:radius="25dp" />

            <stroke
                android:width="1dp"
                android:color="#25FFFFFF" />

        </shape>

    </item>

</layer-list>