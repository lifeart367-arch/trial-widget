<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark blue tinted translucent glass -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#3A182B42" />

            <corners android:radius="28dp" />

            <stroke
                android:width="1dp"
                android:color="#80D9E8F5" />

        </shape>
    </item>

    <!-- Very subtle glass depth -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#201D3850"
                android:centerColor="#10182B40"
                android:endColor="#30101C2D" />

            <corners android:radius="27dp" />

        </shape>

    </item>

    <!-- Soft upper reflection -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="70dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#18FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />

            <corners android:radius="25dp" />

        </shape>

    </item>

    <!-- Fine inner glass edge -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">

        <shape android:shape="rectangle">

            <solid android:color="#08000000" />

            <corners android:radius="25dp" />

            <stroke
                android:width="1dp"
                android:color="#35D9E8F5" />

        </shape>

    </item>

</layer-list>