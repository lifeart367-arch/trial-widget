<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft foggy atmosphere -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#29333D"
                android:centerColor="#596671"
                android:endColor="#A9B2B8" />

            <corners android:radius="28dp" />

        </shape>
    </item>

    <!-- Diffused upper light -->
    <item
        android:left="-60dp"
        android:top="-50dp"
        android:right="70dp"
        android:bottom="60dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="125dp"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

    <!-- Soft mist at the bottom -->
    <item
        android:left="60dp"
        android:top="75dp"
        android:right="-60dp"
        android:bottom="-55dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="125dp"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

</layer-list>