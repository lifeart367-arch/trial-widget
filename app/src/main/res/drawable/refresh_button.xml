<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape android:shape="oval">

            <solid android:color="#32FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />

        </shape>

    </item>

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">

            <gradient
                android:angle="135"
                android:startColor="#35FFFFFF"
                android:endColor="#08FFFFFF" />

        </shape>

    </item>

</layer-list>