<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Very subtle glass outline -->
    <item>

        <shape
            android:shape="rectangle">

            <solid
                android:color="#00FFFFFF" />

            <corners
                android:radius="28dp" />

            <stroke
                android:width="1dp"
                android:color="#28D9E8F5" />

        </shape>

    </item>

    <!-- Soft light catching the right edge -->
    <item
        android:left="92dp">

        <shape
            android:shape="rectangle">

            <gradient
                android:angle="180"
                android:startColor="#22FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />

            <corners
                android:radius="28dp" />

        </shape>

    </item>

</layer-list>