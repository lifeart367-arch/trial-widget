<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep atmospheric base -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#0D47A1"
                android:centerColor="#1976D2"
                android:endColor="#64B5F6" />

            <corners android:radius="28dp" />

        </shape>
    </item>

    <!-- Soft sunlight glow -->
    <item
        android:left="70dp"
        android:top="-35dp"
        android:right="-35dp"
        android:bottom="45dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="100dp"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

    <!-- Subtle lower atmospheric glow -->
    <item
        android:left="-50dp"
        android:top="90dp"
        android:right="80dp"
        android:bottom="-60dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="120dp"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

</layer-list>