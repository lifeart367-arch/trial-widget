<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep storm atmosphere -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#090817"
                android:centerColor="#211A3D"
                android:endColor="#514276" />

            <corners android:radius="28dp" />

        </shape>
    </item>

    <!-- Distant lightning glow -->
    <item
        android:left="65dp"
        android:top="-45dp"
        android:right="-45dp"
        android:bottom="65dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="125dp"
                android:startColor="#45E8E0FF"
                android:endColor="#00E8E0FF" />

        </shape>

    </item>

    <!-- Deep lower storm haze -->
    <item
        android:left="-55dp"
        android:top="75dp"
        android:right="70dp"
        android:bottom="-55dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="130dp"
                android:startColor="#252D2355"
                android:endColor="#002D2355" />

        </shape>

    </item>

</layer-list>