<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep rainy sky -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="135"
                android:startColor="#061426"
                android:centerColor="#123B5D"
                android:endColor="#397FA3" />

            <corners android:radius="28dp" />

        </shape>
    </item>

    <!-- Cold atmospheric light -->
    <item
        android:left="-55dp"
        android:top="-40dp"
        android:right="80dp"
        android:bottom="65dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="125dp"
                android:startColor="#30BFE8FF"
                android:endColor="#00BFE8FF" />

        </shape>

    </item>

    <!-- Soft reflection near the bottom -->
    <item
        android:left="70dp"
        android:top="80dp"
        android:right="-60dp"
        android:bottom="-50dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="120dp"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

</layer-list>